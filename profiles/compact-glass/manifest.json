{
  "format": 1,
  "name": "compact-glass",
  "description": "Reusable source profile for the compact glass TV launcher.",
  "minimum_android_sdk": 26,
  "installer": "install.ps1",
  "theme": "config.json",
  "campfire": {
    "file": "media/campfire.mp4",
    "credits": "media/CREDITS.md",
    "bundled_clip_silent": true,
    "custom_audio_supported": true,
    "custom_audio_gain_default": 3,
    "volume_muted_by_default": true,
    "enabled_by_default": false
  },
  "wallpapers": {
    "directory": "wallpapers",
    "source_manifest": "wallpapers.sources.json",
    "night_source_manifest": "night-wallpapers.sources.json",
    "count": 14,
    "night_schedule_without_location": "19:00-07:00 in the TV time zone",
    "minimum_width_pixels": 3557,
    "maximum_width_pixels": 3840
  },
  "components": [
    {
      "name": "TV launcher",
      "package": "com.gathin.tvhome",
      "source": "../../launcher",
      "built_from_source": true,
      "required": true
    },
    {
      "name": "PS5 input shortcut",
      "package": "com.local.grundig.playstation",
      "source": "console-shortcut",
      "built_from_source": true,
      "required": false,
      "configuration": ["Ps5InputId", "Ps5TvPackage"]
    }
  ],
  "third_party_apps_installed": [],
  "packages_disabled": [],
  "device_specific_values_required": ["TvHost"],
  "private_runtime_output": "../../backup/compact-glass-<timestamp>/"
}
